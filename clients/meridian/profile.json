      "tool": "support.ticket_update",
      "parameters": {
        "ticketId": "T-1001",
        "status": "closed"
      },
      "expect": "denied"
    },
    {
      "id": "protected-deploy",
      "agent": "it-agent",
      "tool": "it.deploy",
      "parameters": {
        "service": "checkout",
        "branch": "main"
      },
      "expect": "denied"
    },
    {
      "id": "development-deploy",
      "agent": "it-agent",
      "tool": "it.deploy",
      "parameters": {
        "service": "checkout",
        "branch": "develop"
      },
      "expect": "executed"
