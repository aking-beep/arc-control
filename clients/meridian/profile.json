      "declaredTools": [
        "finance.refund"
      ],
      "governance": {
        "purpose": "Operate finance.refund under ARC policy",
        "department": "finance",
        "criticality": "high",
        "deploymentRef": "arc-control-sandbox",
        "dataClassification": [
