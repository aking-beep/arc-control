{
  "id": "meridian",
  "name": "Meridian Commerce Group (synthetic enterprise, mirrors aking-beep/arc-control-sandbox)",
  "organizationId": "meridian",
  "environment": "sandbox",
  "requirements": {
    "separationOfDutiesForIrreversible": true
  },
  "tools": [
    {
      "name": "finance.refund",
      "description": "Meridian synthetic finance.refund operation",
      "system": "finance",
      "effect": "irreversible",
      "riskTier": "critical",
      "connector": "meridian-http",
      "parameters": [
        {
          "name": "customer",
          "type": "string",
          "required": true
        },
        {
          "name": "amount",
          "type": "number",
          "required": true
        }
      ],
      "labels": {
        "environment": "synthetic"
      }
    },
    {
      "name": "support.ticket_update",
      "description": "Meridian synthetic support.ticket_update operation",
      "system": "support",
      "effect": "write",
      "riskTier": "medium",
      "connector": "meridian-http",
      "parameters": [
        {
          "name": "ticketId",
          "type": "string",
          "required": true
        },
        {
          "name": "status",
          "type": "string",
          "required": true
        }
      ],
      "labels": {
        "environment": "synthetic"
      }
    },
    {
      "name": "it.deploy",
      "description": "Meridian synthetic it.deploy operation",
      "system": "it",
      "effect": "write",
      "riskTier": "high",
      "connector": "meridian-http",
      "parameters": [
        {
          "name": "service",
          "type": "string",
          "required": true
        },
        {
          "name": "branch",
          "type": "string",
          "required": true
        }
      ],
      "labels": {
        "environment": "synthetic"
      }
    },
    {
      "name": "sales.export_customers",
      "description": "Meridian synthetic sales.export_customers operation",
      "system": "sales",
      "effect": "write",
      "riskTier": "critical",
      "connector": "meridian-http",
      "parameters": [
        {
          "name": "scope",
          "type": "string",
          "required": true
        }
      ],
      "labels": {
        "environment": "synthetic"
      }
    },
    {
      "name": "hr.salary_read",
      "description": "Meridian synthetic hr.salary_read operation",
      "system": "hr",
      "effect": "read",
      "riskTier": "high",
      "connector": "meridian-http",
      "parameters": [
        {
          "name": "employeeId",
          "type": "string",
          "required": true
        }
      ],
      "labels": {
        "environment": "synthetic"
      }
    },
    {
      "name": "security.quarantine",
      "description": "Meridian synthetic security.quarantine operation",
      "system": "security",
      "effect": "write",
      "riskTier": "high",
      "connector": "meridian-http",
      "parameters": [
        {
          "name": "resource",
          "type": "string",
          "required": true
        },
        {
          "name": "reason",
          "type": "string",
          "required": true
        }
      ],
      "labels": {
        "environment": "synthetic"
      }
    }
  ],
  "agents": [
