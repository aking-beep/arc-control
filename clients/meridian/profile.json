        ]
      }
    },
    {
      "name": "support-agent",
      "owner": "support-agent@meridian.example",
      "roles": [
        "support"
      ],
      "declaredTools": [
        "support.ticket_update"
      ],
      "governance": {
        "purpose": "Operate support.ticket_update under ARC policy",
        "department": "support",
        "criticality": "high",
        "deploymentRef": "arc-control-sandbox",
        "dataClassification": [
          "synthetic"
        ]
      }
    },
    {
      "name": "it-agent",
      "owner": "it-agent@meridian.example",
      "roles": [
        "it"
      ],
      "declaredTools": [
        "it.deploy"
      ],
      "governance": {
        "purpose": "Operate it.deploy under ARC policy",
        "department": "it",
        "criticality": "high",
        "deploymentRef": "arc-control-sandbox",
        "dataClassification": [
          "synthetic"
        ]
      }
    },
    {
      "name": "sales-agent",
      "owner": "sales-agent@meridian.example",
      "roles": [
        "sales"
      ],
      "declaredTools": [
        "sales.export_customers"
      ],
      "governance": {
        "purpose": "Operate sales.export_customers under ARC policy",
        "department": "sales",
        "criticality": "high",
        "deploymentRef": "arc-control-sandbox",
        "dataClassification": [
          "synthetic"
        ]
      }
    },
    {
      "name": "hr-agent",
      "owner": "hr-agent@meridian.example",
      "roles": [
        "hr"
      ],
      "declaredTools": [
        "hr.salary_read"
      ],
      "governance": {
        "purpose": "Operate hr.salary_read under ARC policy",
        "department": "hr",
        "criticality": "high",
        "deploymentRef": "arc-control-sandbox",
        "dataClassification": [
          "synthetic"
        ]
      }
    },
    {
      "name": "security-agent",
      "owner": "security-agent@meridian.example",
      "roles": [
        "security"
      ],
      "declaredTools": [
        "security.quarantine"
      ],
      "governance": {
        "purpose": "Operate security.quarantine under ARC policy",
        "department": "security",
        "criticality": "high",
        "deploymentRef": "arc-control-sandbox",
        "dataClassification": [
          "synthetic"
        ]
      }
    }
  ],
  "approvers": [
    {
      "identifier": "controller@meridian.example",
      "roles": [
        "finance-manager"
      ]
    },
    {
      "identifier": "security-lead@meridian.example",
      "roles": [
        "security-manager"
      ]
    },
    {
      "identifier": "hr-lead@meridian.example",
      "roles": [
        "hr-manager"
      ]
    }
  ],
  "policies": [
    {
      "id": "MER-FIN-001",
      "version": 1,
      "name": "Meridian finance.refund policy",
      "enabled": true,
      "match": {
        "tools": [
          "finance.refund"
        ]
      },
      "rules": [
        {
          "id": "different-agent",
          "when": {
            "ne": [
              "$.agent.name",
              "finance-agent"
            ]
          },
          "effect": "DENY",
          "reason": "only finance-agent may request this operation"
        },
        {
          "id": "under-500",
          "when": {
            "lt": [
              "$.action.parameters.amount",
              500
            ]
          },
          "effect": "ALLOW",
          "reason": "within autonomous refund authority"
        },
        {
          "id": "manager-approval",
          "when": {
            "lte": [
              "$.action.parameters.amount",
              2500
            ]
          },
          "effect": "REQUIRE_APPROVAL",
          "reason": "finance manager must approve",
          "approval": {
            "approvers": [
              "role:finance-manager"
            ],
            "minApprovals": 1,
            "expiresInSeconds": 3600,
            "requireSeparationOfDuties": true
          }
        },
        {
          "id": "over-ceiling",
          "when": {
            "always": true
          },
          "effect": "DENY",
          "reason": "refund exceeds absolute ceiling"
        }
      ],
      "fallback": {
        "effect": "DENY",
        "reason": "no authorized rule matched"
      }
    },
    {
      "id": "MER-SUP-001",
      "version": 1,
      "name": "Meridian support.ticket_update policy",
      "enabled": true,
      "match": {
        "tools": [
          "support.ticket_update"
        ]
      },
      "rules": [
        {
          "id": "different-agent",
          "when": {
            "ne": [
              "$.agent.name",
              "support-agent"
            ]
          },
          "effect": "DENY",
          "reason": "only support-agent may request this operation"
        },
        {
          "id": "ticket-update",
          "when": {
            "always": true
          },
          "effect": "ALLOW",
          "reason": "ticket updates allowed"
        }
      ],
      "fallback": {
        "effect": "DENY",
        "reason": "no authorized rule matched"
      }
    },
    {
      "id": "MER-IT-001",
      "version": 1,
      "name": "Meridian it.deploy policy",
      "enabled": true,
      "match": {
        "tools": [
          "it.deploy"
        ]
      },
      "rules": [
        {
          "id": "different-agent",
          "when": {
            "ne": [
              "$.agent.name",
              "it-agent"
            ]
          },
          "effect": "DENY",
          "reason": "only it-agent may request this operation"
        },
        {
          "id": "protected-branch",
          "when": {
            "in": [
              "$.action.parameters.branch",
              [
                "main",
                "master",
                "release"
              ]
            ]
          },
          "effect": "DENY",
          "reason": "protected branch cannot be deployed by agent"
        },
        {
          "id": "sandbox-deploy",
          "when": {
            "always": true
          },
          "effect": "ALLOW",
          "reason": "development deployment allowed"
        }
      ],
      "fallback": {
        "effect": "DENY",
        "reason": "no authorized rule matched"
      }
    },
    {
      "id": "MER-SALES-001",
      "version": 1,
      "name": "Meridian sales.export_customers policy",
      "enabled": true,
      "match": {
        "tools": [
          "sales.export_customers"
        ]
      },
      "rules": [
        {
          "id": "different-agent",
          "when": {
            "ne": [
              "$.agent.name",
              "sales-agent"
            ]
          },
          "effect": "DENY",
          "reason": "only sales-agent may request this operation"
        },
        {
          "id": "review-export",
          "when": {
            "always": true
          },
          "effect": "REQUIRE_APPROVAL",
          "reason": "CRM bulk export requires review",
          "approval": {
            "approvers": [
              "role:security-manager"
            ],
            "minApprovals": 1,
            "expiresInSeconds": 3600,
            "requireSeparationOfDuties": true
          }
        }
      ],
      "fallback": {
        "effect": "DENY",
        "reason": "no authorized rule matched"
      }
    },
    {
      "id": "MER-HR-001",
      "version": 1,
      "name": "Meridian hr.salary_read policy",
      "enabled": true,
      "match": {
        "tools": [
          "hr.salary_read"
        ]
      },
      "rules": [
        {
          "id": "different-agent",
          "when": {
            "ne": [
              "$.agent.name",
              "hr-agent"
            ]
          },
          "effect": "DENY",
          "reason": "only hr-agent may request this operation"
        },
        {
          "id": "review-salary",
          "when": {
            "always": true
          },
          "effect": "REQUIRE_APPROVAL",
          "reason": "salary access requires HR approval",
          "approval": {
            "approvers": [
              "role:hr-manager"
            ],
            "minApprovals": 1,
            "expiresInSeconds": 3600,
            "requireSeparationOfDuties": true
          }
        }
      ],
      "fallback": {
        "effect": "DENY",
        "reason": "no authorized rule matched"
      }
    },
    {
      "id": "MER-SEC-001",
      "version": 1,
      "name": "Meridian security.quarantine policy",
      "enabled": true,
      "match": {
        "tools": [
          "security.quarantine"
        ]
      },
      "rules": [
        {
          "id": "different-agent",
          "when": {
            "ne": [
              "$.agent.name",
              "security-agent"
            ]
          },
          "effect": "DENY",
          "reason": "only security-agent may request this operation"
        },
        {
          "id": "review-quarantine",
          "when": {
            "always": true
          },
          "effect": "REQUIRE_APPROVAL",
          "reason": "system quarantine requires human approval",
          "approval": {
            "approvers": [
              "role:security-manager"
            ],
            "minApprovals": 1,
            "expiresInSeconds": 3600,
            "requireSeparationOfDuties": true
          }
        }
      ],
      "fallback": {
        "effect": "DENY",
        "reason": "no authorized rule matched"
      }
    }
  ],
