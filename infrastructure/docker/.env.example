# Shared operator token. Operator endpoints refuse every request without it.
#   openssl rand -hex 32
ARC_OPERATOR_TOKEN=

# Identity and roles the console presents when voting on approvals. In v0.1
# these are configuration, not authenticated claims — see docs/TRUST_MODEL.md.
ARC_OPERATOR_IDENTITY=operator@localhost
ARC_OPERATOR_ROLES=finance-manager,platform-oncall

# Load the worked example from the README. Never set this in production.
ARC_SEED_DEMO=false
