# ---------------------------------------------------------------------------
# Who your operators are
# ---------------------------------------------------------------------------
#
# Set these and operators sign in individually through your identity provider:
# ARC Control verifies the ID token against the provider's published keys and
# takes roles from a verified claim. Approvals are then attributable to a
# person, which is the whole point of a control plane.
#
# Leave them unset and the deployment falls back to the shared token below,
# recording every approval as `claimed` — honest, and weaker than it reads.
#
# The redirect URI must be registered with the provider exactly as written,
# and must be the address a *browser* reaches, not the compose service name.
ARC_OIDC_ISSUER=
ARC_OIDC_CLIENT_ID=
ARC_OIDC_CLIENT_SECRET=
ARC_OIDC_REDIRECT_URI=http://127.0.0.1:8787/auth/callback

# Which provider claim carries group membership, and how those groups map to
# ARC Control roles. Without a mapping every operator signs in with no roles,
# and so can approve nothing.
ARC_OIDC_ROLE_CLAIM=groups
ARC_OIDC_ROLE_MAP=arc-finance=finance-manager,arc-oncall=platform-oncall

# Signs the server-side session cookie. Required with single sign-on.
#   openssl rand -hex 32
ARC_SESSION_SECRET=

# Sessions ride a plain-HTTP loopback port in this compose file, so the cookie
# cannot be marked Secure. Put TLS in front and set this to true.
ARC_SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# The fallback
# ---------------------------------------------------------------------------
#
# One token for everyone, with identity taken from a request header: anyone
# holding it can claim any identity. Accepted only while no provider above is
# configured — a fallback, never a bypass.
#   openssl rand -hex 32
ARC_OPERATOR_TOKEN=
ARC_OPERATOR_IDENTITY=operator@localhost
ARC_OPERATOR_ROLES=finance-manager,platform-oncall

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------

# Where people reach the console. Two jobs, both load-bearing: notifications
# use it to say where to act, and a completed sign-in uses it to send the
# operator back to the page they came from. Without it they land on the API.
ARC_CONSOLE_URL=http://127.0.0.1:8788

# Run assessments, expire approvals and sweep on a schedule. Off means an
# approval queue can rot unattended.
ARC_SCHEDULE=true

# Load the worked example from the README. Never set this in production.
ARC_SEED_DEMO=false
