  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@arc-control/schemas": "0.1.0",
    "@arc-control/store": "0.1.0",
    "@arc-control/policy-engine": "0.1.0",
    "@arc-control/audit": "0.1.0",
    "@arc-control/mcp-security": "0.1.0",
    "@arc-control/gateway": "0.1.0",
    "@arc-control/execution": "0.1.0",
    "@arc-control/agent-identity": "0.1.0",
    "@arc-control/sdk-typescript": "0.1.0",
    "@arc-control/connector-simulation": "0.1.0",
    "@arc-control/connector-mcp": "0.1.0",
    "@arc-control/evidence": "0.1.0",
    "@arc-control/assurance": "0.1.0"
  }
}
