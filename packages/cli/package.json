{
  "name": "@arc-control/cli",
  "version": "0.1.0",
  "description": "The arc command line: policy checks, agent management, evidence and audit verification.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
